---
/*
  Small inline glyphs for the contact links (email, phone, LinkedIn). Mail and
  phone are plain stroked shapes that inherit the surrounding link color via
  currentColor; LinkedIn is the official brand mark, so it keeps its own
  brand blue rather than following currentColor.
*/
interface Props {
  name: 'mail' | 'phone' | 'linkedin';
}

const { name } = Astro.props;
---

{
  name === 'mail' && (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <rect x="1.5" y="3" width="13" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M2 4l6 5 6-5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'phone' && (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path
        d="M3.5 2h2l1 3-1.5 1.2a8 8 0 0 0 3.8 3.8L10 8.5l3 1v2c0 .8-.7 1.4-1.5 1.3A11 11 0 0 1 2.2 3.5C2.1 2.7 2.7 2 3.5 2z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  /* Official LinkedIn "in" badge mark, in LinkedIn's brand blue. */
  name === 'linkedin' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="#0A66C2"
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
      />
    </svg>
  )
}

<style>
  .icon {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    flex-shrink: 0;
  }
</style>
