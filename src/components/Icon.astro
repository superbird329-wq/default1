---
/*
  Small inline glyphs for the contact links (email, phone, LinkedIn). Drawn as
  plain stroked/filled shapes rather than trademarked logo marks, sized to sit
  on the text baseline and inherit the surrounding link color.
*/
interface Props {
  name: 'mail' | 'phone' | 'linkedin';
}

const { name } = Astro.props;
---

{
  name === 'mail' && (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <rect x="1.5" y="3" width="13" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M2 4l6 5 6-5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'phone' && (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path
        d="M3.5 2h2l1 3-1.5 1.2a8 8 0 0 0 3.8 3.8L10 8.5l3 1v2c0 .8-.7 1.4-1.5 1.3A11 11 0 0 1 2.2 3.5C2.1 2.7 2.7 2 3.5 2z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'linkedin' && (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <rect x="1" y="1" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
      <circle cx="4.7" cy="5" r="1" fill="currentColor" />
      <path d="M4.7 7v4.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path
        d="M7.8 11.3V7c0-1.3 3.5-1.3 3.5 0v4.3M7.8 8.6h3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
    </svg>
  )
}

<style>
  .icon {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    flex-shrink: 0;
  }
</style>
