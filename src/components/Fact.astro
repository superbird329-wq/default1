---
import { isTodo } from '../data/site';
import { splitAfter } from '../lib/text';

/*
  A single labelled field: a small uppercase mono caption over its value. This
  is the atom of the title-block device (spec §7.2) and is reused in the site
  footer, the project context strips, and the credentials strip.

  A value that is still a TODO renders as a loud marker rather than as text, so
  an unfilled fact can never be mistaken for a supplied one (spec §3.1).
*/

interface Props {
  label: string;
  value: string | null | undefined;
  href?: string;
  /** Render the value in the body face instead of mono (for prose values). */
  prose?: boolean;
  /**
   * Allow the value to wrap after this character rather than mid-word.
   * Pass "@" for an email address.
   */
  wrapAfter?: string;
}

const { label, value, href, prose = false, wrapAfter } = Astro.props;
const todo = isTodo(value);
const segments = !todo && value && wrapAfter ? splitAfter(value, wrapAfter) : null;
---

<div class="fact">
  <span class="label">{label}</span>
  {
    todo ? (
      <span class="todo">{value}</span>
    ) : href ? (
      <a class:list={['value', { 'value--prose': prose }]} href={href}>
        {segments
          ? segments.map((segment, i) => (
              <>
                {segment}
                {i < segments.length - 1 && <wbr />}
              </>
            ))
          : value}
      </a>
    ) : (
      <span class:list={['value', { 'value--prose': prose }]}>{value}</span>
    )
  }
</div>

<style>
  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .value {
    overflow-wrap: anywhere;
  }

  .value--prose {
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  /*
    A linked value is a real tap target, so it needs the 44px minimum. The
    padding grows the hit area and the matching negative margin pulls the
    surrounding layout back, so the title block looks identical while the
    touchable region is full size.
  */
  a.value {
    display: inline-block;
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    text-decoration-color: var(--c-rule);
  }

  a.value:hover {
    text-decoration-color: var(--c-accent);
  }
</style>
