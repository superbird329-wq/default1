---
import { SITE, isTodo } from '../data/site';
import Fact from './Fact.astro';

/*
  The signature element (spec §7.2), in its persistent form: a title block.

  On a drawing sheet the title block sits in a fixed position and tells you who
  drew the sheet, what it is, and when — before you look at the drawing. Here it
  carries the contact information the spec requires on every page (§5), in the
  same fixed grid of labelled cells, divided by hairlines.

  Contact is a mailto: and a tel: link. There is no contact form: a form adds a
  backend dependency and a spam surface for no benefit.
*/

const { email, phone, linkedin } = SITE.contact;

const mailto = isTodo(email) ? undefined : `mailto:${email}`;
const tel = phone && !isTodo(phone) ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const linkedinHref = isTodo(linkedin) ? undefined : linkedin;

const linkedinLabel = isTodo(linkedin)
  ? linkedin
  : linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\/in\//, '').replace(/\/$/, '');

const updated = new Date().toISOString().slice(0, 10);
---

<footer class="site-footer">
  <div class="wrap">
    <h2 class="visually-hidden">Contact</h2>

    <div class="title-block grid-rules">
      <Fact label="Name" value={SITE.name} />
      <Fact label="Program" value="BS Construction Management Eng. Tech." prose />
      <Fact label="Email" value={email} href={mailto} wrapAfter="@" />
      {phone && <Fact label="Phone" value={phone} href={tel} />}
      <Fact label="LinkedIn" value={linkedinLabel} href={linkedinHref} icon="linkedin" />
      <Fact label="Updated" value={updated} />
    </div>

    <p class="site-footer__note">
      &copy; {new Date().getFullYear()} {SITE.name}. Built as a static site; no
      trackers, no cookies, no analytics.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-3xl);
    border-block-start: var(--rule-heavy) solid var(--c-ink);
    padding-block: var(--space-l) var(--space-xl);
    background: var(--c-surface);
  }

  /*
    The title block grid. Cells are divided by hairlines drawn as gaps over an
    ink ground, which keeps every rule exactly 1px regardless of how the cells
    reflow — the same trick a sheet border uses.
  */
  /* Rules come from the shared .grid-rules utility; this sets only the columns. */
  .title-block {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .title-block > :global(.fact) {
    padding: var(--space-xs) var(--space-s);
  }

  /*
    Program and Email are the two long values. Below the 6-across desktop
    layout, give them their own full-width row instead of squeezing them
    into a half-width cell, so "BS Construction Management Eng. Tech." and
    the email address each read on one line -- and push that pair to the
    bottom of the stack (via `order`) so the short paired facts read first.
  */
  .title-block > :global(.fact:nth-child(1)) {
    order: 1;
  }

  .title-block > :global(.fact:nth-child(2)) {
    order: 5;
    grid-column: 1 / -1;
  }

  .title-block > :global(.fact:nth-child(3)) {
    order: 6;
    grid-column: 1 / -1;
  }

  .title-block > :global(.fact:nth-child(4)) {
    order: 2;
  }

  .title-block > :global(.fact:nth-child(5)) {
    order: 3;
  }

  .title-block > :global(.fact:nth-child(6)) {
    order: 4;
  }

  .site-footer__note {
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    color: var(--c-graphite);
  }

  @media (min-width: 48em) {
    .title-block {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /*
    Six across only once each cell can actually hold an email address; below
    that the title block stays at three and runs to two rows.
  */
  @media (min-width: 82em) {
    .title-block {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .title-block > :global(.fact) {
      order: initial;
    }

    .title-block > :global(.fact:nth-child(2)),
    .title-block > :global(.fact:nth-child(3)) {
      grid-column: auto;
    }
  }
</style>
