---
import { SITE } from '../data/site';
import { canonicalPath } from '../lib/url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  /** Full <title>. Unique per page (spec §9). */
  title: string;
  /** Meta description. Unique per page (spec §9). */
  description: string;
  /** JSON-LD structured data, serialised into a script tag. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;

const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const ogImage = SITE.ogImageAvailable ? new URL('/og-default.png', Astro.site).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      /*
        Indexing switch (spec §9 / Phase 0 decision: unindexed until the content
        is complete). Flip SITE.indexable in src/data/site.ts to publish.
      */
    }
    {!SITE.indexable && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {
      /*
        Preload only the two faces needed for first paint: body regular and the
        condensed display weight. Mono is used below the fold on most pages and
        loads normally.
      */
    }
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-condensed-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f6f7" />

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
